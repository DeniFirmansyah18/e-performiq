import { describe, it, expect, beforeAll, afterAll, vi } from 'vitest';
import type { PGlite } from '@electric-sql/pglite';
import { createTestDb } from '../setup';
import { runSeed, DEMO_PAYSLIP_PIN } from '@/lib/db/seed';

// getVerifiedPayslip memakai singleton getDb(); arahkan ke DB in-memory milik tes.
const holder: { client: PGlite | null } = { client: null };
vi.mock('@/lib/db/client', () => ({
  getDb: async () => {
    if (!holder.client) throw new Error('test DB belum siap');
    return holder.client;
  },
}));

import { getVerifiedPayslip } from '@/lib/services/payrollFinanceService';

// Budi Pratama (EMPLOYEE) dari seed
const EMP = 'b0000000-0000-4000-8000-000000000004';

describe('Task 10: PIN gaji hash bcrypt', () => {
  let client: PGlite;

  beforeAll(async () => {
    ({ client } = await createTestDb());
    holder.client = client;
    await runSeed(client);
  });

  afterAll(async () => {
    await client.close();
  });

  it('menolak PIN yang salah dan menerima PIN yang benar (bcrypt)', async () => {
    await expect(
      getVerifiedPayslip({ employeeId: EMP, pin: '000000' })
    ).rejects.toThrow(/PIN keamanan tidak valid/);

    const slip = await getVerifiedPayslip({ employeeId: EMP, pin: DEMO_PAYSLIP_PIN });
    expect(slip.fullName).toBe('Budi Pratama');
    expect(slip.netSalary).toBeGreaterThan(0);
  });

  it('menyimpan payslip_pin_hash sebagai hash bcrypt, bukan plaintext', async () => {
    const r = await client.query<{ payslip_pin_hash: string }>(
      'SELECT payslip_pin_hash FROM employees WHERE id = $1',
      [EMP]
    );
    const h = r.rows[0].payslip_pin_hash;
    expect(h).toMatch(/^\$2[aby]\$/);
    expect(h).not.toContain(DEMO_PAYSLIP_PIN);
  });

  it('menolak akses bila PIN belum diatur', async () => {
    await client.query('UPDATE employees SET payslip_pin_hash = NULL WHERE id = $1', [EMP]);
    await expect(
      getVerifiedPayslip({ employeeId: EMP, pin: DEMO_PAYSLIP_PIN })
    ).rejects.toThrow(/belum diatur/);
  });
});
