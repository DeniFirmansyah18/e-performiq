'use client';

import React, { useState } from 'react';
import { MessageSquare, ShieldCheck, X, AlertCircle } from 'lucide-react';

interface HelpdeskTicketModalProps {
isOpen: boolean;
onClose: () => void;
onSuccess: (msg: string) => void;
}

const UMUM_CATEGORIES = ['IT & Sistem', 'Sarana & Fasilitas', 'Kepegawaian', 'Lainnya'];
const WBS_CATEGORIES = [
'Fraud / Kecurangan',
'Korupsi & Gratifikasi',
'Pelecehan',
'Pelanggaran Kode Etik',
'Lainnya',
];

export default function HelpdeskTicketModal({ isOpen, onClose, onSuccess }: HelpdeskTicketModalProps) {
const [tab, setTab] = useState<'umum' | 'wbs'>('umum');
const [ticketCategory, setTicketCategory] = useState(UMUM_CATEGORIES[0]);
const [subject, setSubject] = useState('');
const [detail, setDetail] = useState('');
const [priority, setPriority] = useState('MEDIUM');
const [isSubmitting, setIsSubmitting] = useState(false);
const [errorMsg, setErrorMsg] = useState('');

if (!isOpen) return null;

const isWbs = tab === 'wbs';
const categories = isWbs ? WBS_CATEGORIES : UMUM_CATEGORIES;

const switchTab = (t: 'umum' | 'wbs') => {
setTab(t);
setTicketCategory(t === 'wbs' ? WBS_CATEGORIES[0] : UMUM_CATEGORIES[0]);
setErrorMsg('');
};

const handleSubmit = async (e: React.FormEvent) => {
e.preventDefault();
setIsSubmitting(true);
setErrorMsg('');



try {
  const res = await fetch('/api/v1/governance/helpdesk', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      isWhistleblowing: isWbs,
      ticketCategory,
      subject,
      detail,
      priority,
    }),
  });

  const json = await res.json();
  if (!res.ok) {
    setErrorMsg(json.detail || json.message || 'Gagal membuat tiket.');
    return;
  }

  onSuccess(
    isWbs ? 'Laporan pelanggaran terkirim secara anonim.' : 'Tiket bantuan berhasil dibuat.'
  );
  onClose();
} catch (err: any) {
  setErrorMsg(err.message || 'Terjadi kesalahan sistem.');
} finally {
  setIsSubmitting(false);
}
};

return (





<div className={p-2 rounded-lg text-white ${isWbs ? 'bg-emerald-700' : 'bg-rose-600'}}>
{isWbs ? : }


Tiket Bantuan & Pelaporan

Kotak 6: Helpdesk & Whistleblowing (GCG)









    <div className="p-5 space-y-4">
      {/* Tabs */}
      <div className="grid grid-cols-2 gap-1 p-1 rounded-xl bg-slate-100 text-xs font-semibold">
        <button
          type="button"
          onClick={() => switchTab('umum')}
          className={`py-2 rounded-lg transition-colors ${
            !isWbs ? 'bg-white text-slate-900 shadow-xs' : 'text-slate-500 hover:text-slate-700'
          }`}
        >
          Tiket Umum
        </button>
        <button
          type="button"
          onClick={() => switchTab('wbs')}
          className={`py-2 rounded-lg transition-colors ${
            isWbs ? 'bg-white text-emerald-800 shadow-xs' : 'text-slate-500 hover:text-slate-700'
          }`}
        >
          Pelaporan Pelanggaran
        </button>
      </div>

      {isWbs && (
        <div className="p-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs flex items-start gap-2">
          <ShieldCheck className="h-4 w-4 flex-shrink-0 mt-0.5" />
          <span>
            <strong>Privasi GCG Terjamin.</strong> Laporan pelanggaran (WBS) bersifat anonim —
            identitas pelapor tidak disimpan dalam sistem.
          </span>
        </div>
      )}

      <form onSubmit={handleSubmit} className="space-y-4">
        {errorMsg && (
          <div className="p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-xs flex items-start gap-2">
            <AlertCircle className="h-4 w-4 flex-shrink-0 mt-0.5" />
            <span>{errorMsg}</span>
          </div>
        )}

        <div className="grid grid-cols-2 gap-3">
          <div>
            <label className="block text-xs font-semibold text-slate-700 mb-1">Kategori</label>
            <select
              value={ticketCategory}
              onChange={(e) => setTicketCategory(e.target.value)}
              className="w-full px-3 py-2 text-xs rounded-xl border border-slate-300 focus:outline-none focus:border-rose-600 bg-white"
            >
              {categories.map((c) => (
                <option key={c} value={c}>
                  {c}
                </option>
              ))}
            </select>
          </div>
          <div>
            <label className="block text-xs font-semibold text-slate-700 mb-1">Prioritas</label>
            <select
              value={priority}
              onChange={(e) => setPriority(e.target.value)}
              className="w-full px-3 py-2 text-xs rounded-xl border border-slate-300 focus:outline-none focus:border-rose-600 bg-white"
            >
              <option value="LOW">Rendah</option>
              <option value="MEDIUM">Sedang</option>
              <option value="HIGH">Tinggi</option>
              <option value="URGENT">Mendesak</option>
            </select>
          </div>
        </div>

        <div>
          <label className="block text-xs font-semibold text-slate-700 mb-1">Subjek</label>
          <input
            type="text"
            value={subject}
            onChange={(e) => setSubject(e.target.value)}
            placeholder={isWbs ? 'Ringkasan pelanggaran yang dilaporkan' : 'Ringkasan kebutuhan bantuan'}
            className="w-full px-3 py-2 text-xs rounded-xl border border-slate-300 focus:outline-none focus:border-rose-600"
            required
            minLength={5}
          />
        </div>

        <div>
          <label className="block text-xs font-semibold text-slate-700 mb-1">Detail</label>
          <textarea
            rows={4}
            value={detail}
            onChange={(e) => setDetail(e.target.value)}
            placeholder={
              isWbs
                ? 'Jelaskan kronologi, pihak terkait, dan bukti pendukung (tanpa mencantumkan identitas Anda).'
                : 'Jelaskan kendala atau kebutuhan Anda secara rinci.'
            }
            className="w-full px-3 py-2 text-xs rounded-xl border border-slate-300 focus:outline-none focus:border-rose-600"
            required
            minLength={10}
          />
        </div>

        <button
          type="submit"
          disabled={isSubmitting}
          className={`w-full py-2.5 rounded-xl disabled:opacity-50 text-white text-xs font-bold transition-colors ${
            isWbs ? 'bg-emerald-700 hover:bg-emerald-800' : 'bg-rose-600 hover:bg-rose-700'
          }`}
        >
          {isSubmitting ? 'Mengirim...' : isWbs ? 'Kirim Laporan Anonim' : 'Buat Tiket'}
        </button>
      </form>
    </div>
  </div>
</div>
);
}
