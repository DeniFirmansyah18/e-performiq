{
  "name": "e-performiq",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "db:seed": "tsx src/lib/db/seed/index.ts",
    "db:migrate:pg": "node scripts/require-db-url.mjs && tsx src/lib/db/migrate.ts",
    "db:seed:pg": "node scripts/require-db-url.mjs && tsx src/lib/db/seed/index.ts",
    "db:reset": "node -e \"require('fs').rmSync('.pglite',{recursive:true,force:true})\" && npm run db:migrate && npm run db:seed",
    "services:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-services.ps1 start",
    "services:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-services.ps1 stop",
    "services:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-services.ps1 status",
    "services:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-services.ps1 restart",
    "services:autostart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register-autostart.ps1 register",
    "services:no-autostart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register-autostart.ps1 unregister",
    "services:autostart-status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register-autostart.ps1 status",
    "clamav:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-clamav.ps1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@electric-sql/pglite": "^0.2.17",
    "@tanstack/react-query": "^5.103.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.36.4",
    "jose": "^5.10.0",
    "lucide-react": "^0.453.0",
    "next": "^14.2.15",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.28.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
