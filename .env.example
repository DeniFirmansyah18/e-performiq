# E-PerformIQ — contoh variabel lingkungan
# Salin menjadi `.env.local` lalu isi nilainya. JANGAN commit file rahasia.

# --- Wajib di produksi ---
# Kunci penandatanganan JWT sesi (ganti dengan string acak >= 32 karakter).
JWT_SECRET=dev-only-secret-ganti-di-produksi

# --- Database ---
# LOKAL (default): biarkan DATABASE_URL kosong -> aplikasi memakai PGlite
# (PostgreSQL 16 in-process), data tersimpan di direktori di bawah.
PGLITE_DATA_DIR=.pglite

# PRODUKSI / VERCEL (WAJIB): PGlite tidak bisa jalan di serverless (FS read-only).
# Set connection string PostgreSQL server (Neon / Vercel Postgres / Supabase),
# contoh: postgres://user:pass@host/db?sslmode=require
# Bila di-set, aplikasi otomatis memakai driver postgres-js dan mengabaikan PGlite.
DATABASE_URL=

# --- AI (opsional) — provider-agnostic: Gemini, Groq & OpenRouter ---
# Tanpa kunci, fitur AI berjalan dalam mode fallback ramah
# (configured:false, HTTP 200) — bukan error.
#
# Provider aktif: 'gemini' | 'groq' | 'openrouter'. Bila dikosongkan, dipilih
# otomatis dari provider yang punya kunci (prioritas: gemini > groq > openrouter).
# Bila provider utama gagal/kena rate limit, otomatis dicoba provider lain yang
# terkonfigurasi (fallback berantai).
AI_PROVIDER=

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Model. Default: gemini-flash-latest (otomatis model Flash terbaru)
GEMINI_MODEL=gemini-flash-latest

# Groq (https://console.groq.com/keys) - cepat & punya free tier
GROQ_API_KEY=
# Model Groq. Daftar aktif: https://console.groq.com/docs/models
# Pilihan chat: openai/gpt-oss-120b (default), openai/gpt-oss-20b, qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter (https://openrouter.ai/settings/keys) - agregator banyak model (ada :free)
OPENROUTER_API_KEY=
# Model. Default: qwen/qwen3.8-27b:free. Daftar gratis: https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
# Opsional (atribusi app untuk OpenRouter)
OPENROUTER_SITE_URL=https://e-performiq.vercel.app

# --- Next.js ---
NODE_ENV=development
