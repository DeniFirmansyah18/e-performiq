# E-PerformIQ — contoh variabel lingkungan
# Salin menjadi `.env.local` lalu isi nilainya. JANGAN commit file rahasia.

# --- Wajib di produksi ---
# Kunci penandatanganan JWT sesi (ganti dengan string acak >= 32 karakter).
JWT_SECRET=dev-only-secret-ganti-di-produksi

# --- Database ---
# LOKAL (default): biarkan DATABASE_URL kosong -> aplikasi memakai PGlite
# (PostgreSQL 16 in-process), data tersimpan di direktori di bawah.
PGLITE_DATA_DIR=.pglite

# PRODUKSI / VERCEL (WAJIB): PGlite tidak bisa jalan di serverless (FS read-only).
# Set connection string PostgreSQL server (Neon / Vercel Postgres / Supabase),
# contoh: postgres://user:pass@host/db?sslmode=require
# Bila di-set, aplikasi otomatis memakai driver postgres-js dan mengabaikan PGlite.
DATABASE_URL=

# --- AI (opsional) — provider-agnostic: Gemini, Groq & OpenRouter ---
# Tanpa kunci, fitur AI berjalan dalam mode fallback ramah
# (configured:false, HTTP 200) — bukan error.
#
# Provider aktif: 'gemini' | 'groq' | 'openrouter'. Bila dikosongkan, dipilih
# otomatis dari provider yang punya kunci (prioritas: gemini > groq > openrouter).
# Bila provider utama gagal/kena rate limit, otomatis dicoba provider lain yang
# terkonfigurasi (fallback berantai).
AI_PROVIDER=

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Model. Default: gemini-flash-latest (otomatis model Flash terbaru)
GEMINI_MODEL=gemini-flash-latest

# Groq (https://console.groq.com/keys) - cepat & punya free tier
GROQ_API_KEY=
# Model Groq. Daftar aktif: https://console.groq.com/docs/models
# Pilihan chat: openai/gpt-oss-120b (default), openai/gpt-oss-20b, qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter (https://openrouter.ai/settings/keys) - agregator banyak model (ada :free)
OPENROUTER_API_KEY=
# Model. Default: qwen/qwen3.8-27b:free. Daftar gratis: https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
# Opsional (atribusi app untuk OpenRouter)
OPENROUTER_SITE_URL=https://e-performiq.vercel.app

# --- Email notifikasi kandidat (opsional) ---
# Notifikasi progress lamaran dikirim ke email kandidat. Tanpa konfigurasi,
# email tetap tercatat di tabel `email_outbox` (status QUEUED) dan tetap tampil
# sebagai notifikasi in-app di portal kandidat. Untuk PENGIRIMAN NYATA, pilih
# salah satu provider di bawah.
#
# Provider email: 'resend' | 'webhook' (kosong = nonaktif, hanya outbox).
EMAIL_PROVIDER=
# Alamat pengirim. Untuk Resend, domain harus sudah diverifikasi di dashboard
# Resend (mis. onboarding@resend.dev untuk uji coba). Format: "Nama <email>".
EMAIL_FROM=E-PerformIQ <onboarding@resend.dev>

# Resend (https://resend.com/api-keys) — paling sederhana, gratis 3.000 email/bln
RESEND_API_KEY=

# Gateway webhook/SMTP-HTTP generik (opsional). Server Anda menerima POST JSON
# { to, subject, text, html, from } lalu meneruskannya via SMTP/penyedia lain.
# Cocok bila memakai SMTP korporat yang dibungkus endpoint HTTP.
EMAIL_WEBHOOK_URL=
# Header otorisasi opsional untuk webhook (mis. "Bearer <token>").
EMAIL_WEBHOOK_AUTH=

# --- WhatsApp notifikasi kandidat (opsional) ---
# Notifikasi progress lamaran juga dikirim via WhatsApp ke nomor kandidat.
# Tanpa konfigurasi, pesan tetap tercatat di tabel `whatsapp_outbox` (QUEUED).
# Pilih salah satu provider:
#   WHATSAPP_PROVIDER=fonnte   -> isi WHATSAPP_TOKEN (https://fonnte.com)
#   WHATSAPP_PROVIDER=wablas   -> isi WHATSAPP_TOKEN + WABLAS_DOMAIN (https://wablas.com)
#   WHATSAPP_PROVIDER=meta     -> isi WHATSAPP_TOKEN + META_PHONE_NUMBER_ID (WhatsApp Cloud API resmi)
#   WHATSAPP_PROVIDER=webhook  -> isi WHATSAPP_WEBHOOK_URL (gateway HTTP/SMTP Anda)
# Auto-detect bila WHATSAPP_PROVIDER dikosongkan.
WHATSAPP_PROVIDER=
# Token API provider WhatsApp (fonnte/wablas/meta).
WHATSAPP_TOKEN=
# Domain konsol Wablas (mis. https://console.wablas.com).
WABLAS_DOMAIN=
# ID nomor telepon WhatsApp Cloud API (Meta).
META_PHONE_NUMBER_ID=
# Gateway webhook generik (menerima POST JSON { target, message }).
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_AUTH=

# --- Referensi pendidikan (opsional) ---
# URL layanan scraper PDDikti milik sendiri (FastAPI: pddikti-pt-api).
# Dipakai untuk pencarian perguruan tinggi + detail/prodi di form lamaran.
# Contoh: http://127.0.0.1:8000 (default dev) atau URL deployment Anda.
# Kosongkan bila tidak dipakai -> otomatis fallback ke seed lokal.
PDDIKTI_API_URL=

# --- Referensi alamat/wilayah (opsional) ---
# URL layanan Wilayah Alamat API milik sendiri (FastAPI: wilayah-alamat-api).
# Dipakai untuk dropdown alamat bertingkat di form lamaran:
# Provinsi → Kab/Kota → Kecamatan → Desa/Kelurahan + kode pos.
# Contoh: http://127.0.0.1:8001 (default dev) atau URL deployment Anda.
# Kosongkan bila tidak dipakai -> kandidat mengetik alamat manual.
WILAYAH_API_URL=

# --- Google Meet (opsional) — buat tautan wawancara otomatis ---
# Dipakai oleh endpoint POST /api/v1/recruitment/interviews/generate-room.
# Bila KETIGA kredensial di bawah diisi, sistem memakai Google Meet REST API
# (https://meet.googleapis.com/v2/spaces) dengan alur Refresh Token OAuth2.
# Bila belum diisi, sistem otomatis FALLBACK ke generator tautan
# meet.google.com/xxx-xxxx-xxx — jadi fitur tetap berfungsi tanpa kredensial.
#
# Cara mendapatkan kredensial (Google Cloud Console):
#   1. Buat project → aktifkan "Google Meet API".
#   2. OAuth consent screen → tambahkan scope:
#      https://www.googleapis.com/auth/meetings.space.created
#   3. Buat OAuth Client ID (tipe "Web application") → dapat CLIENT_ID & CLIENT_SECRET.
#   4. Otorisasi sekali (offline) untuk mendapatkan REFRESH_TOKEN dari akun Google.
#
# Set GOOGLE_MEET_ENABLED=false untuk mematikan Google Meet API secara eksplisit
# (tetap memakai fallback). Biarkan kosong/true untuk mengaktifkan.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_MEET_ENABLED=

# --- Next.js ---
NODE_ENV=development
